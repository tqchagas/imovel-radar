# Include these locations inside the radar.leilaolabs.com.br server block.
# The app protects /admin and its APIs with the password configured in
# ADMIN_PASSWORD. The ITBI upload continues to use Nginx Basic Auth; its
# htpasswd file must exist on the Nginx host and must never be committed here.

location = /admin {
    proxy_pass http://imovel-radar-web:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /admin/api/ {
    proxy_read_timeout 600s;
    proxy_pass http://imovel-radar-web:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /enviar {
    auth_basic "ImovelRadar admin";
    auth_basic_user_file /etc/nginx/secrets/radar.htpasswd;
    proxy_pass http://imovel-radar-web:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location = /upload {
    auth_basic "ImovelRadar admin";
    auth_basic_user_file /etc/nginx/secrets/radar.htpasswd;
    client_max_body_size 200m;
    proxy_read_timeout 600s;
    proxy_pass http://imovel-radar-web:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

# The login shell and its assets are public; the app guards the data and actions
# behind the password-protected /admin/api/ endpoints. Exact matches take
# precedence over /static/.
location = /static/enviar.html {
    auth_basic "ImovelRadar admin";
    auth_basic_user_file /etc/nginx/secrets/radar.htpasswd;
    proxy_pass http://imovel-radar-web:8000;
}

location = /static/enviar.js {
    auth_basic "ImovelRadar admin";
    auth_basic_user_file /etc/nginx/secrets/radar.htpasswd;
    proxy_pass http://imovel-radar-web:8000;
}

location = /static/admin.html {
    proxy_pass http://imovel-radar-web:8000;
}

location = /static/admin.js {
    proxy_pass http://imovel-radar-web:8000;
}

location = /static/admin.css {
    proxy_pass http://imovel-radar-web:8000;
}
