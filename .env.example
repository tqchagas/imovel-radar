# --- Postgres (used by docker compose) ---
POSTGRES_USER=imovelradar
POSTGRES_PASSWORD=imovelradar
POSTGRES_DB=imovelradar
# Host port bound to 127.0.0.1 only (see docker-compose.yml).
POSTGRES_PORT=5433

# --- Web (docker compose) ---
# Host port bound to 127.0.0.1 only.
WEB_PORT=8000

# --- App (local uvicorn / tools on the host) ---
# Inside Docker, compose overrides this with host=postgres.
DATABASE_URL=postgresql+psycopg://imovelradar:imovelradar@localhost:5433/imovelradar

# Pre-build /stats/curiosities on boot. Production sets this in
# docker-compose.prod.yml; leave off locally unless you want a 15s startup scan.
WARM_CURIOSITIES_ON_STARTUP=false

# QuintoAndar session cookie (5AJWT_AUTH value). OPTIONAL: the price-suggestion
# endpoint answers anonymously and returns the same payload either way, so leave
# this blank. Personal/session-bound — never commit a real value.
QUINTOANDAR_PRICE_SUGGESTION_COOKIE=

# Pace floor for the price-suggestion endpoint, in seconds. It is not paginated
# like the search APIs: one estimate per listing is what a browsing human
# generates, so it gets a much slower floor than HTTP_MIN_INTERVAL_SECONDS.
QPRECO_MIN_INTERVAL_SECONDS=3.0

# Market listing collectors. Override only when using a proxy or test endpoint.
QUINTOANDAR_SEARCH_API_URL=https://apigw.prod.quintoandar.com.br/house-listing-search/v3/search/list
VIVAREAL_API_URL=https://glue-api.vivareal.com/v4/listings
LOFT_SEARCH_API_URL=https://landscape-api.loft.com.br/listing/v4/search

# --- Rede dos coletores ---
# Os portais limitam a taxa e devolvem 5xx sob carga. Retentativa com espera
# exponencial e um piso entre requisicoes evitam tomar bloqueio.
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1.0
HTTP_MAX_BACKOFF_SECONDS=30
HTTP_MIN_INTERVAL_SECONDS=0.35

# --- Coleta agendada (docker compose --profile scheduler) ---
SWEEP_CITY=Belo Horizonte
SWEEP_UF=MG
SWEEP_SOURCES=loft quintoandar vivareal
# Uma varredura por dia. Cada ciclo percorre todos os bairros com ITBI suficiente.
SWEEP_INTERVAL_SECONDS=86400
SWEEP_MAX_PAGES=100
SWEEP_FILTERS={"tipo_imovel": "APARTAMENTO"}

# --- Alertas de oportunidade (SMTP) ---
# Sem SMTP_HOST o job calcula as oportunidades mas não envia e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@imovelradar.local
SMTP_USE_TLS=true
SMTP_SUBJECT_PREFIX=[ImovelRadar]

# Diretorio de condominios do QuintoAndar: o numero da rua que Loft e
# QuintoAndar nao publicam no anuncio. Sao 19.117 paginas em BH, de quase um
# megabyte cada, entao a coleta e dirigida pelo anuncio e tem teto por ciclo.
CONDO_LIMIT=500
# Piso entre requisicoes ao diretorio. Uma pagina por segundo e a ordem de
# grandeza de um humano navegando, e o sitemap existe para ser lido - mas o
# volume aqui e de milhares, nao de dezenas.
CONDO_MIN_INTERVAL_SECONDS=1.0
