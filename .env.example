# --- Postgres (used by docker compose) ---
POSTGRES_USER=imovelradar
POSTGRES_PASSWORD=imovelradar
POSTGRES_DB=imovelradar
# Host port bound to 127.0.0.1 only (see docker-compose.yml).
POSTGRES_PORT=5433

# --- Web (docker compose) ---
# Host port bound to 127.0.0.1 only.
WEB_PORT=8000

# --- App (local uvicorn / tools on the host) ---
# Inside Docker, compose overrides this with host=postgres.
DATABASE_URL=postgresql+psycopg://imovelradar:imovelradar@localhost:5433/imovelradar

# Pre-build /stats/curiosities on boot. Production sets this in
# docker-compose.prod.yml; leave off locally unless you want a 15s startup scan.
WARM_CURIOSITIES_ON_STARTUP=false

# QuintoAndar session cookie (5AJWT_AUTH value) used for price-suggestion lookups.
# Personal/session-bound — never commit a real value. Leave blank if unused.
QUINTOANDAR_PRICE_SUGGESTION_COOKIE=

# Market listing collectors. Override only when using a proxy or test endpoint.
QUINTOANDAR_SEARCH_API_URL=https://apigw.prod.quintoandar.com.br/house-listing-search/v2/search/list
VIVAREAL_API_URL=https://glue-api.vivareal.com/v4/listings

# --- Alertas de oportunidade (SMTP) ---
# Sem SMTP_HOST o job calcula as oportunidades mas não envia e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@imovelradar.local
SMTP_USE_TLS=true
SMTP_SUBJECT_PREFIX=[ImovelRadar]
