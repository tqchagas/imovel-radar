# --- Postgres (used by docker compose) ---
POSTGRES_USER=imovelradar
POSTGRES_PASSWORD=imovelradar
POSTGRES_DB=imovelradar
# Host port bound to 127.0.0.1 only (see docker-compose.yml).
POSTGRES_PORT=5433

# --- Web (docker compose) ---
# Host port bound to 127.0.0.1 only.
WEB_PORT=8000

# --- App (local uvicorn / tools on the host) ---
# Inside Docker, compose overrides this with host=postgres.
DATABASE_URL=postgresql+psycopg://imovelradar:imovelradar@localhost:5433/imovelradar

# QuintoAndar session cookie (5AJWT_AUTH value) used for price-suggestion lookups.
# Personal/session-bound — never commit a real value. Leave blank if unused.
QUINTOANDAR_PRICE_SUGGESTION_COOKIE=
