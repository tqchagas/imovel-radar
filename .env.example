# Used for local development. Override is set in docker-compose.yml for Docker.
DATABASE_URL=postgresql+psycopg://imovelradar:imovelradar@localhost:5433/imovelradar

# QuintoAndar session cookie (5AJWT_AUTH value) used for price-suggestion lookups.
# Personal/session-bound — never commit a real value. Leave blank if unused.
QUINTOANDAR_PRICE_SUGGESTION_COOKIE=
